<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name="C-Play/cplay.conf" />
  <group name="Presentation">
    <entry name="NdiReceiveGpuConversion" type="bool">
      <label>Convert opaque NDI input from UYVY to RGB using the GPU. Recreate NDI layers after changing this setting.</label>
      <default>false</default>
    </entry>
    <entry name="NdiOutputGpuConversion" type="bool">
      <label>Convert NDI output from RGB to UYVY using the GPU. Restart NDI outputs after changing this setting. Output alpha is discarded.</label>
      <default>false</default>
    </entry>
    <entry name="PresentationToLoadOnStartup" type="String">
      <label>A presentation to load at startup</label>
    </entry>
    <entry name="RecentLoadedPresentations" type="StringList">
      <label>Recently loaded presentations</label>
    </entry>
    <entry name="FadeDurationToPreviousSlide" type="int">
      <default>20</default>
    </entry>
    <entry name="FadeDurationToNextSlide" type="int">
      <default>2000</default>
    </entry>
    <entry name="ClearAndLoadDelay" type="int">
      <default>1000</default>
    </entry>
    <entry name="SyncAfterLoadDelay" type="int">
      <default>1000</default>
    </entry>
    <entry name="StartAfterLoadDelay" type="int">
      <default>5000</default>
    </entry>
  	<entry name="DefaultStereoModeForLayers" type="int">
      <label>The default stereoscopic mode for new layers</label>
      <default>0</default>
    </entry>
	  <entry name="DefaultGridModeForLayers" type="int">
      <label>The default grid mode for new layers</label>
      <default>1</default>
    </entry>
    <entry name="GuessGridModeOnDragAndDrop" type="bool">
      <label>Guess grid mode on drag-and-drop</label>
      <default>true</default>
    </entry>
	  <entry name="DefaultLayerVisibility" type="int">
      <label>The default visibility for new layers</label>
      <default>0</default>
    </entry>
    <entry name="PdfDpi" type="int">
      <label>The DPI (dots per inch) for PDF rendering to image.</label>
      <default>300</default>
    </entry>
    <entry name="UpdateUpcomingSlideCount" type="int">
      <label>Update certain number of upcoming slides after triggered slide.</label>
      <default>2</default>
    </entry>
    <entry name="NetworkSyncIterations" type="int">
      <label>Sync layers fully this many times when things changes to account for network packet loss.</label>
      <default>30</default>
    </entry>
    <entry name="MediaVisibilityControlMasterLayers" type="bool">
      <default>true</default>
    </entry>
    <entry name="MasterVolumeControlLayersVolume" type="bool">
      <default>true</default>
    </entry>
    <entry name="MasterSlideCanHaveLockableLayers" type="bool">
      <default>false</default>
    </entry>
    <entry name="CustomSlidesCanHaveLockableLayers" type="bool">
      <default>false</default>
    </entry>
    <entry name="PreLoadLayers" type="bool">
      <label>Pre-load all layers at startup instead of on-demand</label>
      <default>false</default>
    </entry>
    <entry name="ShowTipsAtStartup" type="bool">
      <label>Show tips at startup in the layers list</label>
      <default>true</default>
    </entry>
    <entry name="SlidesViewVisibilityAtStartup" type="int">
      <label>When to show the slides view at startup (0=show on presentation load, 1=always show at startup, 2=hide at startup)</label>
      <default>0</default>
    </entry>
    <entry name="LayersViewVisibilityAtStartup" type="int">
      <label>When to show the layers view at startup (0=show on presentation load, 1=always show at startup, 2=hide at startup)</label>
      <default>0</default>
    </entry>
    <entry name="CtrlDragLayerAction" type="int">
      <label>Which operation Ctrl+left-drag performs on the selected layer in the 3D view (0=elevation &amp; azimuth, 1=elevation only, 2=azimuth only, 3=horizontal &amp; vertical move, 4=horizontal move only, 5=vertical move only, 6=resize plane size, 7=move plane distance)</label>
      <default>0</default>
    </entry>
    <entry name="AltDragLayerAction" type="int">
      <label>Which operation Alt+left-drag performs on the selected layer in the 3D view (same options as CtrlDragLayerAction)</label>
      <default>0</default>
    </entry>
    <entry name="ShiftDragLayerAction" type="int">
      <label>Which operation Shift+left-drag performs on the selected layer in the 3D view (same options as CtrlDragLayerAction)</label>
      <default>6</default>
    </entry>
  </group>
  <group name="NodeStream">
    <entry name="NodeStreamBaseGroup" type="String">
      <label>Multicast group of layer streams to the nodes. Each layer uses the next group, unless overridden on the layer.</label>
      <default>239.192.77.1</default>
    </entry>
    <entry name="NodeStreamBasePort" type="int">
      <label>UDP port of layer streams to the nodes, unless overridden on the layer.</label>
      <default>50100</default>
    </entry>
    <entry name="NodeStreamInterface" type="String">
      <label>IPv4 address of the master network interface to send from. Empty uses the master address of the cluster configuration.</label>
      <default></default>
    </entry>
    <entry name="NodeStreamTTL" type="int">
      <label>Multicast time-to-live (number of router hops).</label>
      <default>1</default>
    </entry>
    <entry name="NodeStreamMaxDatagram" type="int">
      <label>Largest UDP datagram in bytes. 1472 fits a standard 1500 MTU, 8972 fits 9000 byte jumbo frames.</label>
      <default>1472</default>
    </entry>
    <entry name="NodeStreamRateMbps" type="int">
      <label>Combined send rate limit of all layer streams in Mbit/s. 0 uses 85% of the link speed of the send interface.</label>
      <default>0</default>
    </entry>
    <entry name="NodeStreamCompressLz4" type="bool">
      <label>Compress the layer streams with LZ4 before sending them to the nodes.</label>
      <default>false</default>
    </entry>
    <entry name="NodeStreamDeltaFrames" type="bool">
      <label>Send only the regions of a layer that changed since the previous frame, with a full keyframe at the keyframe interval.</label>
      <default>true</default>
    </entry>
    <entry name="NodeStreamKeyframeIntervalMs" type="int">
      <label>How often a full frame is sent, for nodes that joined late or lost packets, in milliseconds.</label>
      <default>500</default>
      <min>50</min>
      <max>10000</max>
    </entry>
    <entry name="NodeStreamFrameLockedWaitMs" type="int">
      <label>How long a node waits for a late frame in frame-locked mode, in milliseconds.</label>
      <default>2</default>
    </entry>
    <entry name="NodeStreamLatencyGuardMs" type="int">
      <label>In frame-locked mode, the nodes are told to show a frame only once it has been on the wire this many milliseconds.</label>
      <default>1</default>
    </entry>
    <entry name="NodeStreamAllowPartialFrames" type="bool">
      <label>Let the nodes show frames with lost packets on top of the previous frame, instead of holding the previous frame.</label>
      <default>false</default>
    </entry>
    <entry name="NodeStreamLoopback" type="bool">
      <label>Deliver the streams to nodes on the master computer as well.</label>
      <default>true</default>
    </entry>
    <entry name="NodeStreamPreferNdi" type="bool">
      <label>Prefer streaming the layers to the nodes over NDI, instead of UDP multicast. The nodes then receive the streams with automatically created NDI layers. Can be overridden per layer.</label>
      <default>false</default>
    </entry>
  </group>
</kcfg>
