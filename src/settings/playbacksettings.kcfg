<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name="C-Play/cplay.conf" />
  <group name="Playback">
    <entry name="UseThresholdToSyncTimePosition" type="bool">
      <label>Use functionality to sync time based on position threshold</label>
      <default>true</default>
    </entry>
    <entry name="ThresholdToSyncTimePosition" type="int">
      <default>100</default>
    </entry>
    <entry name="ThresholdToSyncTimeSkipSets" type="int">
      <default>10</default>
    </entry>
    <entry name="ApplyThresholdSyncOnLoopOnly" type="bool">
      <label>Sync time based on threshold for looping only</label>
      <default>true</default>
    </entry>
    <entry name="TimeToCheckThresholdSyncAfterLoop" type="int">
      <default>500</default>
    </entry>
    <entry name="SyncVolumeVisibilityFading" type="bool">
      <label>Sync volume+visibility fading</label>
      <default>false</default>
    </entry>
    <entry name="FadeDuration" type="int">
      <default>2000</default>
    </entry>
    <entry name="RewindOnEOFwhenPause" type="bool">
      <label>Rewind media if end of file + pause</label>
      <default>false</default>
    </entry>
    <entry name="FadeDownBeforeRewind" type="bool">
      <label>Fade down media visibility before rewind</label>
      <default>false</default>
    </entry>
    <entry name="Visibility" type="Int">
      <label>Visibility at startup</label>
      <default>100</default>
    </entry>
    <entry name="SeekSmallStep" type="Int">
      <label>Seek small step</label>
      <default>5</default>
    </entry>
    <entry name="SeekMediumStep" type="Int">
      <label>Seek medium step</label>
      <default>15</default>
    </entry>
    <entry name="SeekBigStep" type="Int">
      <label>Seek big step</label>
      <default>30</default>
    </entry>
    <entry name="RenderApiType" type="Int">
      <label>MPV render API type used for video rendering (0 = OpenGL, 1 = OpenGL Next)</label>
      <default>0</default>
    </entry>
    <entry name="UseFrameSyncCorrection" type="bool">
      <label>Use frame sync correction (progressive speed adjustment + hard seek to stay in sync)</label>
      <default>false</default>
    </entry>
    <entry name="FrameSyncSeekThreshold" type="double">
      <label>Frame sync: time difference (seconds) before performing a hard seek</label>
      <default>5.0</default>
    </entry>
    <entry name="FrameSyncSpeedAdjustThreshold" type="double">
      <label>Frame sync: time difference (seconds) below which playback is considered in sync</label>
      <default>0.02</default>
    </entry>
    <entry name="FrameSyncMaxSpeedAdjust" type="double">
      <label>Frame sync: maximum playback speed adjustment (fraction, e.g. 0.5 = 50% faster/slower)</label>
      <default>0.5</default>
    </entry>
    <entry name="FrameSyncInitialOffset" type="double">
      <label>Frame sync: initial offset (seconds) applied to the target position on slaves</label>
      <default>0.015</default>
    </entry>
    <entry name="FrameSyncSyncInterval" type="double">
      <label>Frame sync: seconds between position sync updates</label>
      <default>0.5</default>
    </entry>
  </group>
</kcfg>
