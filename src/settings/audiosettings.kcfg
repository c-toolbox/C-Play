<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name="C-Play/cplay.conf" />
  <group name="Audio">
    <entry name="PreferredLanguage" type="String">
      <label>Preferred language</label>
    </entry>
    <entry name="PreferredTrack" type="Int">
      <label>Preferred track</label>
    </entry>
    <entry name="LoadAudioFileInVideoFolder" type="bool">
      <default>true</default>
    </entry>
    <entry name="EnableAudioOnMaster" type="bool">
      <default>true</default>
    </entry>
    <entry name="EnableAudioOnNodes" type="bool">
      <default>false</default>
    </entry>
    <entry name="UseCustomAudioOutput" type="bool">
      <default>false</default>
    </entry>
    <entry name="UseAudioDevice" type="bool">
      <default>false</default>
    </entry>
    <entry name="UseAudioDriver" type="bool">
      <default>false</default>
    </entry>
    <entry name="PreferredAudioOutputDevice" type="String">
      <label>Preferred audio output device</label>
    </entry>
    <entry name="PreferredAudioOutputDriver" type="String">
      <label>Preferred audio output driver</label>
    </entry>
    <entry name="VolumeStep" type="Int">
      <label>Volume step</label>
      <default>5</default>
    </entry>
    <entry name="Volume" type="Int">
      <label>Volume</label>
      <default>100</default>
    </entry>
    <entry name="PortAudioCustomOutput" type="bool">
      <default>false</default>
    </entry>
    <entry name="PortAudioOutputDevice" type="String">
      <label>Preferred portaudio output device used with NDI audio</label>
    </entry>
    <entry name="PortAudioOutputApi" type="String">
      <label>Preferred portaudio host api used with NDI audio</label>
    </entry>
    <entry name="PortAudioWasapiExclusive" type="bool">
      <label>Open a WASAPI output device in exclusive mode; all PortAudio layers are mixed into one stream</label>
      <default>false</default>
    </entry>
    <entry name="PortAudioMixInputToOutput" type="bool">
      <default>false</default>
    </entry>
    <entry name="PortAudioOutputChannels" type="Int">
      <label>Assuming even channels have LFE</label>
      <default>6</default>
    </entry>
    <entry name="PortAudioSpatialMode" type="Int">
      <label>Spatial mapping of PortAudio layer audio: 0 = off, 1 = surround panning, 2 = mono speaker array</label>
      <default>0</default>
    </entry>
    <entry name="PortAudioSpeakerPositions" type="String">
      <label>Speaker positions for the spatial mapping: channel count|azimuth:elevation;... (degrees)</label>
    </entry>
    <entry name="PortAudioSpatialFocus" type="Double">
      <label>Spatial mapping focus: higher keeps the sound closer to the nearest speakers</label>
      <default>4.0</default>
    </entry>
    <entry name="PortAudioSpatialWidth" type="Int">
      <label>Spatial mapping width in percent: how far stereo channels spread across a flat layer</label>
      <default>100</default>
    </entry>
    <entry name="PortAudioSpeakerArray" type="String">
      <label>Speaker array: channel:azimuth:elevation:degrees:height;... (1-based channel, degrees, cm)</label>
    </entry>
    <entry name="PortAudioArrayLayout" type="Int">
      <label>Speaker array positions: 0 = on the dome (azimuth/elevation), 1 = along the circular screen (degrees/height)</label>
      <default>0</default>
    </entry>
    <entry name="PortAudioArrayRolloff" type="Double">
      <label>Speaker array level drop in dB per doubling of the distance to a speaker</label>
      <default>6.0</default>
    </entry>
    <entry name="PortAudioArrayBlur" type="Double">
      <label>Speaker array spatial blur in percent of the dome/circle radius</label>
      <default>5.0</default>
    </entry>
    <entry name="PortAudioArrayConstantPower" type="bool">
      <label>Speaker array: keep the total power constant (otherwise the amplitudes sum to 100%)</label>
      <default>true</default>
    </entry>
  </group>
</kcfg>
